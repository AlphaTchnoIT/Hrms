PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hrms
# Use a long random value in production, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# The first URL is used in password reset emails
CLIENT_URL=http://localhost:3000

# SMTP for emails: password reset links, interview invites, document requests, status changes.
# Needed in production for "Forgot password". Leave SMTP_HOST empty to send in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PeopleHub HRMS <no-reply@example.com>

# Hourly background reminders for tests, training and follow-ups
REMINDERS_ENABLED=true

# Chat audio calls. Voice goes straight between the two browsers (WebRTC), never through this server.
# On the same office network nothing is needed. Over the internet, run your own coturn server
# (open source, e.g. docker run coturn/coturn) with use-auth-secret + static-auth-secret=<TURN_SECRET>.
# Comma separated, e.g. STUN_URLS=stun:turn.example.com:3478
STUN_URLS=
# e.g. TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
TURN_SECRET=
